{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.growcoai.com" }], "destination": "https://growcoai.com/", "permanent": true },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.growcoai.com"
        }
      ],
      "destination": "https://growcoai.com/:path*",
      "permanent": true
    },
    { "source": "/AIFILMMAKER", "destination": "/filmmaker", "permanent": true },
    { "source": "/AIFILMMAKER/:path*", "destination": "/filmmaker", "permanent": true },
    { "source": "/aifilmmaker", "destination": "/filmmaker", "permanent": true },
    { "source": "/Filmmaker", "destination": "/filmmaker", "permanent": true },
    { "source": "/SaaSystem/", "destination": "/SaaSystem", "permanent": true },
    { "source": "/saasystem", "destination": "/SaaSystem", "permanent": true },
    { "source": "/saasystem/", "destination": "/SaaSystem", "permanent": true },
    { "source": "/saasystem/:path(.+)", "destination": "/SaaSystem/:path", "permanent": true },
    { "source": "/Saasystem", "destination": "/SaaSystem", "permanent": true },
    { "source": "/SAASYSTEM", "destination": "/SaaSystem", "permanent": true },
    { "source": "/stockly", "destination": "/SaaSystem", "permanent": true },
    { "source": "/stockly/", "destination": "/SaaSystem", "permanent": true },
    { "source": "/Stockly", "destination": "/SaaSystem", "permanent": true },
    { "source": "/STOCKLY", "destination": "/SaaSystem", "permanent": true },
    { "source": "/SaaSystem/login", "destination": "/SaaSystem/dashboard", "permanent": false },
    { "source": "/SaaSystem/signup", "destination": "/SaaSystem?servicio=stockly", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(css|js)/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|videos|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/SaaSystem/:path(.+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/SaaSystem/:path(.+)",
      "destination": "https://growcodashboard.vercel.app/SaaSystem/:path"
    }
  ]
}
